<style>
:root{color-scheme:dark;--bg:#090807;--panel:#11100e;--line:#ffffff1c;--muted:#aaa19a;--gold:#c4a36a;--red:#8f342e}*{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--bg)}body{margin:0;background:radial-gradient(ellipse at 50% 16%,#4d291b35,transparent 34%),linear-gradient(180deg,#090807,#100d0b 55%,#090807);color:#eee9df;font-family:Vazirmatn,sans-serif}body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.14;background-image:radial-gradient(#d8c9ae .6px,transparent .8px);background-size:31px 37px}a{color:inherit;text-decoration:none}.wrap{width:min(1120px,90%);margin:auto;position:relative}.top{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font:700 17px "DM Sans";letter-spacing:5px;color:var(--gold)}.brand small{display:block;font-size:8px;letter-spacing:2.5px;color:#887e70;margin-top:5px}.nav{display:flex;gap:28px;color:#c4bbb0;font-size:12px}.nav a:hover,.social a:hover{color:var(--gold)}.lang{border:1px solid var(--line);background:#ffffff08;color:var(--gold);padding:8px 12px;cursor:pointer}.hero{min-height:670px;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:25px;padding:55px 0}.eyebrow,.kicker{font:10px "DM Sans";letter-spacing:3px;color:var(--gold)}.eyebrow:before{content:"";display:inline-block;width:24px;height:1px;background:var(--gold);vertical-align:middle;margin:0 0 0 12px}.hero h1{font-size:clamp(48px,7vw,86px);font-weight:400;line-height:1.23;margin:24px 0}.hero h1 em{font-style:normal;color:var(--gold)}.hero p{max-width:590px;color:#b9b0a5;line-height:2.2;font-size:15px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.btn{padding:13px 20px;border:1px solid #b18d56;background:linear-gradient(120deg,#3c2818,#17110b);color:#f0d7a9;font-size:12px}.btn.secondary{background:transparent;border-color:var(--line);color:#d0c7ba}.sigil{width:min(390px,80vw);aspect-ratio:1;border:1px solid #b18d5645;border-radius:50%;margin:auto;display:grid;place-items:center;position:relative;box-shadow:0 0 90px #8d55221a,inset 0 0 70px #8d552212}.sigil:before,.sigil:after{content:"";position:absolute;border:1px solid #b18d5630;border-radius:50%;inset:8%}.sigil:after{inset:18%;border-style:dashed}.sigil-core{width:48%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 40% 35%,#282019,#080706 68%);border:1px solid #c4a36a88;display:grid;place-items:center;color:var(--gold);font:48px "DM Sans";box-shadow:0 0 50px #a56d2730}.sigil-label{position:absolute;bottom:8%;font:9px "DM Sans";letter-spacing:3px;color:#8e806b}.section{padding:75px 0;border-top:1px solid var(--line)}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:30px}.section h2{font-size:clamp(27px,4vw,42px);font-weight:400;margin:10px 0}.section h2 em{font-style:normal;color:var(--gold)}.section-head p{max-width:390px;color:var(--muted);font-size:13px;line-height:2}.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.card{padding:25px;border:1px solid var(--line);background:linear-gradient(145deg,#191510,#0d0b09);min-height:220px}.num{font:11px "DM Sans";color:var(--gold);letter-spacing:2px}.card h3{font-weight:500;font-size:18px;margin:28px 0 10px}.card p{font-size:13px;color:var(--muted);line-height:2}.note{padding:35px;border-right:2px solid var(--gold);background:#ffffff05;margin:20px 0 0}.note p{font-size:clamp(18px,2.5vw,25px);line-height:2;margin:0}.note small{display:block;color:var(--gold);margin-top:20px;font-size:11px}.archive-cta{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:28px;border:1px solid #b18d5640;background:linear-gradient(110deg,#261a11,#100d0b)}.archive-cta p{color:var(--muted);font-size:13px}.arrow{font:25px "DM Sans";color:var(--gold)}footer{padding:30px 0 22px;border-top:1px solid var(--line);color:#8f877d;font-size:11px}.foot{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.social{display:flex;gap:18px}.social a{color:#c7bcae}.credit{margin-top:24px;padding-top:15px;border-top:1px solid var(--line);font:9px "DM Sans";letter-spacing:1.5px;color:#746b61}
@media(max-width:760px){.nav{gap:12px;font-size:10px}.hero{grid-template-columns:1fr;min-height:auto;padding:75px 0}.sigil{width:230px;grid-row:1}.hero-copy{text-align:center}.hero-copy p{margin:auto}.hero .actions{justify-content:center}.principles{grid-template-columns:1fr}.section-head{display:block}.archive-cta{align-items:flex-start;flex-direction:column}.top{height:70px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
