---
const title = "GODHAND — فراتر از معمول";
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080709" />
    <meta name="description" content="GODHAND؛ جهانی تاریک برای اندیشه، کشف و گفت‌وگو." />
    <meta property="og:title" content="GODHAND — Beyond the Ordinary" />
    <meta property="og:description" content="از مرزهای معمول عبور کن." />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/godhand.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <div class="progress" id="progress"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <nav class="section-dots" aria-label="Section navigation"><a href="#world" aria-label="Section 01" data-section="world"></a><a href="#signals" aria-label="Section 02" data-section="signals"></a><a href="#gateway" aria-label="Section 03" data-section="gateway"></a><a href="#about" aria-label="Section 04" data-section="about"></a></nav>
    <button class="sound-toggle" id="soundToggle" type="button" aria-label="Enable ambient sound" aria-pressed="false"><span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="sound-state">SOUND OFF</span></button>

    <header class="header">
      <a class="brand" href="#home" aria-label="GODHAND home">
        <span class="brand-symbol">G<span>✦</span></span>
        <span class="brand-name">GODHAND<small>BEYOND THE ORDINARY</small></span>
      </a>
      <nav class="nav" id="nav">
        <a href="#home" data-fa="خانه" data-en="Home">خانه</a>
        <a href="#world" data-fa="جهان ما" data-en="The world">جهان ما</a>
        <a href="#signals" data-fa="سیگنال‌ها" data-en="Signals">سیگنال‌ها</a>
        <a href="#about" data-fa="درباره" data-en="About">درباره</a>
      </nav>
      <div class="header-actions">
        <button class="language" id="language" type="button" aria-label="Change language">EN</button>
        <a class="header-cta" href="#gateway"><span data-fa="ورود" data-en="Enter">ورود</span><span>↗</span></a>
        <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav" type="button"><i></i><i></i></button>
      </div>
    </header>

    <main>
      <section class="hero" id="home">
        <div class="hero-grid"></div><div class="ash-drift" aria-hidden="true"></div><div class="blade-shadow" aria-hidden="true"></div>
        <div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div>
        <div class="moon-scene" aria-hidden="true">
          <div class="moon-aura"></div><div class="moon"><span></span></div>
          <div class="orbit-line orbit-a"></div><div class="orbit-line orbit-b"></div>
          <div class="moon-dot dot-a"></div><div class="moon-dot dot-b"></div>
        </div>
        <div class="hero-content">
          <div class="eyebrow"><span class="live-dot"></span><span data-fa="در جهانی که رحم نمی‌کند" data-en="IN A WORLD THAT SHOWS NO MERCY">در جهانی که رحم نمی‌کند</span></div>
          <h1><span data-fa="جهان" data-en="THE WORLD">جهان</span><br /><em data-fa="به تو رحم نمی‌کند." data-en="WILL NOT BEND.">به تو رحم نمی‌کند.</em><br /><strong data-fa="تو هم نشکن." data-en="NEITHER WILL YOU.">تو هم نشکن.</strong></h1>
          <p class="hero-description" data-fa="این جهان چیزی به تو بدهکار نیست. هر قدم را خودت بردار؛ هر زخمی را به نشانی از ادامه‌دادن تبدیل کن." data-en="This world owes you nothing. Take every step yourself. Turn every scar into proof that you kept going.">این جهان چیزی به تو بدهکار نیست. هر قدم را خودت بردار؛ هر زخمی را به نشانی از ادامه‌دادن تبدیل کن.</p>
          <div class="hero-actions">
            <a class="button-primary" href="#world"><span data-fa="قدم به تاریکی بگذار" data-en="STEP INTO THE DARK">قدم به تاریکی بگذار</span><b>↗</b></a>
            <a class="text-link" href="#about"><span data-fa="قانون این جهان" data-en="THE CODE">قانون این جهان</span><span>⌄</span></a>
          </div>
          <div class="hero-meta"><span>EST. 2026</span><span class="meta-line"></span><span data-fa="فصل اول / اراده" data-en="CHAPTER I / WILL">فصل اول / اراده</span></div>
        </div>
        <div class="side-label">G / 001 — THE BEGINNING</div>
        <a class="scroll-cue" href="#world"><span data-fa="پایین برو" data-en="SCROLL TO EXPLORE">پایین برو</span><i></i></a>
        <div class="hero-index"><span>01</span><span>/</span><span>04</span></div>
      </section>

      <section class="intro-section section" id="world">
        <div class="section-top"><span class="kicker">01 / THE WILL TO ENDURE</span><span class="section-line"></span><span class="kicker">GODHAND®</span></div>
        <div class="intro-layout">
          <div class="intro-heading"><p class="micro-label" data-fa="قانون اول / بقا" data-en="CODE I / SURVIVAL">قانون اول / بقا</p><h2 data-fa="زخم‌هایت را<br/><em>پنهان نکن.</em>" data-en="DO NOT HIDE<br/><em>YOUR SCARS.</em>">زخم‌هایت را<br/><em>پنهان نکن.</em></h2></div>
          <div class="intro-copy"><span class="big-quote">“</span><p data-fa="قدرت همیشه در پیروزی نیست. گاهی فقط یعنی پس از افتادن، دوباره بلند شوی؛ حتی وقتی هیچ‌کس منتظرت نیست. GODHAND از همین‌جا آغاز می‌شود." data-en="Strength is not always victory. Sometimes it is simply standing up again, even when nobody is waiting. GODHAND begins there.">قدرت همیشه در پیروزی نیست. گاهی فقط یعنی پس از افتادن، دوباره بلند شوی؛ حتی وقتی هیچ‌کس منتظرت نیست. GODHAND از همین‌جا آغاز می‌شود.</p><div class="signature">— THE GODHAND IDEA</div></div>
        </div>
        <div class="intro-bottom"><span>01</span><span data-fa="فکر کن. خلق کن. عبور کن." data-en="THINK. CREATE. TRANSCEND.">فکر کن. خلق کن. عبور کن.</span><span>✳</span></div>
      </section>

      <section class="signals-section section" id="signals">
        <div class="section-top"><span class="kicker">02 / THE PATHS THROUGH DARKNESS</span><span class="section-line"></span><span class="kicker" data-fa="سه مسیر، یک جهان" data-en="THREE PATHS, ONE WORLD">سه مسیر، یک جهان</span></div>
        <div class="signals-heading"><div><p class="micro-label" data-fa="راه‌هایی برای ادامه‌دادن" data-en="WAYS TO KEEP MOVING">راه‌هایی برای ادامه‌دادن</p><h2 data-fa="هر زخم، یک <em>نشان.</em>" data-en="EVERY SCAR, A <em>MARK.</em>">هر زخم، یک <em>نشان.</em></h2></div><p data-fa="سه مسیر برای اندیشیدن، نگه‌داشتن ردپا و ساختن چیزی که هنوز وجود ندارد." data-en="Three paths: think deeper, preserve what matters, and create what does not yet exist.">سه مسیر برای اندیشیدن، نگه‌داشتن ردپا و ساختن چیزی که هنوز وجود ندارد.</p></div>
        <div class="signal-grid">
          <article class="signal-card card-chat"><div class="card-top"><span>01 / INTELLIGENCE</span><span class="card-arrow">↗</span></div><div class="card-art art-chat"><div class="chat-orb"></div><span class="art-cross">✳</span><span class="art-ring"></span></div><div class="card-info"><div><h3 data-fa="گفت‌وگو با ناشناخته" data-en="Talk to the unknown">گفت‌وگو با ناشناخته</h3><p data-fa="ایده‌ها را به حرکت دربیاور." data-en="Give your ideas a voice.">ایده‌ها را به حرکت دربیاور.</p></div><span class="status-pill" data-fa="به‌زودی" data-en="COMING SOON">به‌زودی</span></div><form class="waitlist" id="waitlist"><label for="waitlistEmail" data-fa="برای خبرِ شروع، ایمیلت را ثبت کن" data-en="Get notified when we launch">برای خبرِ شروع، ایمیلت را ثبت کن</label><div class="waitlist-field"><input id="waitlistEmail" name="email" type="email" placeholder="you@example.com" autocomplete="email" required maxlength="254" aria-label="Email address" /><button type="submit" aria-label="Join waitlist">↗</button></div><p class="waitlist-message" id="waitlistMessage" role="status" aria-live="polite" data-fa="ایمیل فقط روی همین دستگاه ذخیره می‌شود." data-en="Your email stays on this device only.">ایمیل فقط روی همین دستگاه ذخیره می‌شود.</p></form></article>
          <article class="signal-card card-archive"><div class="card-top"><span>02 / ARCHIVE</span><a class="card-arrow" href="/archive" aria-label="Open Archive">↗</a></div><div class="card-art art-archive"><div class="archive-rings"></div><span class="archive-glyph">⌘</span><span class="archive-star">✦</span></div><div class="card-info"><div><h3 data-fa="آرشیو بی‌انتها" data-en="The endless archive">آرشیو بی‌انتها</h3><p data-fa="ردی از فکرها و کشف‌ها." data-en="Traces of thoughts and discoveries.">ردی از فکرها و کشف‌ها.</p></div><a class="status-pill" href="/archive" data-fa="ورود به آرشیو" data-en="OPEN ARCHIVE">ورود به آرشیو</a></div></article>
          <article class="signal-card card-creation"><div class="card-top"><span>03 / CREATION</span><a class="card-arrow" href="/idea-lab" aria-label="Open Idea Lab">↗</a></div><div class="card-art art-creation"><div class="creation-shape"></div><span class="creation-star">✧</span><span class="creation-orbit"></span></div><div class="card-info"><div><h3 data-fa="کارگاه ایده‌ها" data-en="The idea lab">کارگاه ایده‌ها</h3><p data-fa="چیزی بساز که قبلاً نبود." data-en="Make something that wasn't there.">چیزی بساز که قبلاً نبود.</p></div><a class="status-pill" href="/idea-lab" data-fa="ورود به کارگاه" data-en="OPEN IDEA LAB">ورود به کارگاه</a></div></article>
        </div>
      </section>

      <section class="quote-section">
        <div class="quote-glow"></div><span class="quote-mark">“</span>
        <p id="quoteText" data-fa="وقتی دنیا تو را به زانو درمی‌آورد، برخاستن تبدیل به پاسخ می‌شود." data-en="When the world brings you to your knees, standing becomes your answer.">وقتی دنیا تو را به زانو درمی‌آورد، برخاستن تبدیل به پاسخ می‌شود.</p>
        <div class="quote-bottom"><span>THOUGHT / <b id="quoteNumber">001</b></span><button id="newQuote" type="button"><span data-fa="یک فکر تازه" data-en="ANOTHER THOUGHT">یک فکر تازه</span><b>⟳</b></button></div>
      </section>

      <section class="gateway-section section" id="gateway">
        <div class="gateway-frame"><div class="gateway-orbit"></div><div class="gateway-content"><span class="kicker">03 / THE NEXT CHAPTER</span><div class="gateway-symbol">G<span>✦</span></div><h2 data-fa="هنوز<br/><em>ایستاده‌ایم.</em>" data-en="STILL<br/><em>STANDING.</em>">هنوز<br/><em>ایستاده‌ایم.</em></h2><p data-fa="این پایان راه نیست. فصل‌های بعدی را با اراده، کنجکاوی و چیزی که خودت می‌سازی ادامه می‌دهیم." data-en="This is not the end. The next chapters will be built with will, curiosity, and what you choose to create.">این پایان راه نیست. فصل‌های بعدی را با اراده، کنجکاوی و چیزی که خودت می‌سازی ادامه می‌دهیم.</p><a href="#home" class="back-top"><span data-fa="بازگشت به بالا" data-en="BACK TO THE TOP">بازگشت به بالا</span><b>↑</b></a></div><span class="gateway-coordinate">35°41' N / 51°25' E</span></div>
      </section>
    </main>

    <footer class="footer" id="about">
      <div class="footer-main"><div class="footer-brand"><a class="brand" href="#home"><span class="brand-symbol">G<span>✦</span></span><span class="brand-name">GODHAND<small>BEYOND THE ORDINARY</small></span></a><p data-fa="برای ذهن‌هایی که به معمول قانع نیستند." data-en="For minds that were never satisfied with ordinary.">برای ذهن‌هایی که به معمول قانع نیستند.</p></div>
        <div class="footer-social"><span class="footer-label" data-fa="پیدایم کن" data-en="FIND ME">پیدایم کن</span>
          <a href="https://instagram.com/amir_afterr" target="_blank" rel="noopener noreferrer" aria-label="Instagram amir_afterr"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle class="fill-dot" cx="18" cy="6" r="1"></circle></svg><span>Instagram</span><b>@amir_afterr</b><i>↗</i></a>
          <a href="https://t.me/AMORYG" target="_blank" rel="noopener noreferrer" aria-label="Telegram AMORYG"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 4 3.8 10.7c-1.2.5-1.2 1.2-.2 1.5l4.4 1.4 1.7 5.2c.2.6.1.8.7.8.5 0 .8-.2 1.1-.5l2.1-2 4.4 3.2c.8.4 1.4.2 1.6-.8L22 5.3C22.3 4.1 21.6 3.6 21 4ZM9 13.3l9.6-6.1c.5-.3.9-.1.5.2l-7.9 7.2-.3 3.4L9 13.3Z"></path></svg><span>Telegram</span><b>@AMORYG</b><i>↗</i></a>
        </div><div class="footer-note"><span class="footer-label" data-fa="زمان محلی شما" data-en="LOCAL TIME">زمان محلی شما</span><strong id="clock" aria-label="Local time">00:00:00</strong><small>EARTH / INTERNET</small></div>
      </div>
      <div class="footer-bottom"><span>© 2026 GODHAND. ALL RIGHTS RESERVED.</span><div class="footer-credit" aria-label="Built by Amir and ChatGPT"><svg viewBox="0 0 32 32" role="img" aria-label="ChatGPT"><path d="M16 3.5a7 7 0 0 0-6.7 5 6.8 6.8 0 0 0-5.1 9.4 6.9 6.9 0 0 0 3.4 8.7 7 7 0 0 0 9.1 2.1 7 7 0 0 0 9.1-2.1 6.9 6.9 0 0 0 3.4-8.7 6.8 6.8 0 0 0-5.1-9.4 7 7 0 0 0-8.1-5Zm0 3a4 4 0 0 1 3.8 2.8l-3.1 1.8-3.1-1.8A4 4 0 0 1 16 6.5Zm-8.1 5.1 3.2 1.8v3.7l-3.2 1.8a3.9 3.9 0 0 1 0-7.3Zm16.2 0a3.9 3.9 0 0 1 0 7.3l-3.2-1.8v-3.7l3.2-1.8ZM13.9 11l2.1-1.2 2.1 1.2v2.4L16 14.6l-2.1-1.2V11Zm-2.8 5.8 2.1 1.2v3.7L10 23.5a4 4 0 0 1-1.2-2.1l2.3-1.3v-3.3Zm9.8 0v3.3l2.3 1.3a4 4 0 0 1-1.2 2.1l-3.2-1.8V18l2.1-1.2Zm-5 2.9 2.1-1.2v3.7l-2.1 1.2-2.1-1.2v-3.7l2.1 1.2Zm-5.8 6.1 3.2-1.8 3.2 1.8a4 4 0 0 1-6.4 0Z"/></svg><span>BUILT BY <b>AMIR</b> × <b>CHATGPT</b></span></div><a href="#home">G ↑</a></div>
    </footer>

    <script>
      const root = document.documentElement;
      const langButton = document.querySelector<HTMLButtonElement>('#language')!;
      let lang: 'fa' | 'en' = 'fa';
      try { lang = localStorage.getItem('godhand-language') === 'en' ? 'en' : 'fa'; } catch { /* Storage may be disabled. */ }
      const renderSafeText = (element: HTMLElement, value: string) => {
        const fragment = document.createDocumentFragment();
        let emphasis: HTMLElement | null = null;
        for (const part of value.split(/(<br\s*\/?\s*>|<\/?em>)/gi)) {
          if (/^<br\s*\/?\s*>$/i.test(part)) (emphasis ?? fragment).append(document.createElement('br'));
          else if (part.toLowerCase() === '<em>') { emphasis = document.createElement('em'); fragment.append(emphasis); }
          else if (part.toLowerCase() === '</em>') emphasis = null;
          else (emphasis ?? fragment).append(document.createTextNode(part));
        }
        element.replaceChildren(fragment);
      };

      const applyLanguage = (next: 'fa' | 'en') => {
        lang = next;
        root.lang = next;
        root.dir = next === 'fa' ? 'rtl' : 'ltr';
        document.querySelectorAll<HTMLElement>('[data-fa][data-en]').forEach((el) => {
          const value = el.dataset[next];
          if (value) renderSafeText(el, value);
        });
        langButton.textContent = next === 'fa' ? 'EN' : 'FA';
        try { localStorage.setItem('godhand-language', next); } catch { /* Language still works for this session. */ }
      };
      langButton.addEventListener('click', () => applyLanguage(lang === 'fa' ? 'en' : 'fa'));
      applyLanguage(lang);

      const menuToggle = document.querySelector<HTMLButtonElement>('#menuToggle')!;
      const nav = document.querySelector<HTMLElement>('#nav')!;
      menuToggle.addEventListener('click', () => {
        nav.classList.toggle('open');
        menuToggle.classList.toggle('active');
        menuToggle.setAttribute('aria-expanded', String(nav.classList.contains('open')));
      });
      nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        nav.classList.remove('open');
        menuToggle.classList.remove('active');
        menuToggle.setAttribute('aria-expanded', 'false');
      }));

      const progress = document.querySelector<HTMLElement>('#progress')!;
      window.addEventListener('scroll', () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.width = (max > 0 ? window.scrollY / max * 100 : 0) + '%';
      }, { passive: true });

      const quotes: Record<'fa' | 'en', string[]> = {
        fa: ['وقتی دنیا تو را به زانو درمی‌آورد، برخاستن تبدیل به پاسخ می‌شود.','زخم، پایان داستان نیست؛ نشانه‌ی عبور از آن است.','لازم نیست شکست‌ناپذیر باشی؛ کافی‌ست تسلیم نشوی.','در تاریکی هم می‌توان مسیر خودت را ساخت.'],
        en: ["When the world brings you to your knees, standing becomes your answer.","A scar is not the end of the story. It is proof you crossed it.","You do not have to be invincible. You only have to keep going.","Even in darkness, you can carve your own path."]
      };
      let quoteIndex = 0;
      document.querySelector<HTMLButtonElement>('#newQuote')!.addEventListener('click', () => {
        quoteIndex = (quoteIndex + 1) % quotes[lang].length;
        const quote = document.querySelector<HTMLElement>('#quoteText')!;
        quote.classList.add('fade');
        window.setTimeout(() => {
          quote.textContent = quotes[lang][quoteIndex];
          document.querySelector<HTMLElement>('#quoteNumber')!.textContent = String(quoteIndex + 1).padStart(3, '0');
          quote.classList.remove('fade');
        }, 180);
      });

      const clock = document.querySelector<HTMLElement>('#clock')!;
      const updateClock = () => clock.textContent = new Intl.DateTimeFormat(lang === 'fa' ? 'fa-IR' : 'en-GB', {hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date());
      updateClock();
      let clockTimer: number | undefined;
      const startClock = () => { if (clockTimer === undefined) { updateClock(); clockTimer = window.setInterval(updateClock, 1000); } };
      const stopClock = () => { if (clockTimer !== undefined) { window.clearInterval(clockTimer); clockTimer = undefined; } };
      startClock();
      document.addEventListener('visibilitychange', () => document.hidden ? stopClock() : startClock());

      const canvas = document.querySelector<HTMLCanvasElement>('#stars')!;
      const ctx = canvas.getContext('2d')!;
      let particles: Array<{x:number;y:number;r:number;a:number;s:number}> = [];
      let width = 0, height = 0, pixelRatio = 1;
      const resizeStars = () => {
        pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
        width = window.innerWidth; height = window.innerHeight;
        canvas.width = width * pixelRatio; canvas.height = height * pixelRatio;
        canvas.style.width = width + 'px'; canvas.style.height = height + 'px';
        ctx.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        particles = Array.from({length: Math.min(85, Math.floor(width / 13))}, () => ({
          x: Math.random() * width, y: Math.random() * height, r: Math.random() * 1.25 + .25,
          a: Math.random() * .48 + .12, s: Math.random() * .18 + .025
        }));
      };
      const drawStars = () => {
        ctx.clearRect(0, 0, width, height);
        particles.forEach(p => {
          p.y -= p.s;
          if (p.y < -3) { p.y = height + 3; p.x = Math.random() * width; }
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(224,176,170,' + p.a + ')'; ctx.fill();
        });
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && !document.hidden) starsFrame = requestAnimationFrame(drawStars);
      };
      let starsFrame = 0;
      resizeStars(); drawStars();
      window.addEventListener('resize', resizeStars, {passive:true});
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(starsFrame);
        else if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) starsFrame = requestAnimationFrame(drawStars);
      });

      // Subtle magnetic response on pointer devices only.
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLElement>('.button-primary, .header-cta, .back-top, .text-link, .card-arrow').forEach(el => {
          el.addEventListener('pointermove', event => {
            const rect = el.getBoundingClientRect();
            const x = (event.clientX - rect.left - rect.width / 2) * .08;
            const y = (event.clientY - rect.top - rect.height / 2) * .08;
            el.style.transform = `translate3d(${x}px,${y}px,0)`;
          });
          el.addEventListener('pointerleave', () => { el.style.transform = ''; });
        });
      }

      // Cinematic parallax is pointer/scroll driven, frame-limited, and disabled for reduced motion.
      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const hero = document.querySelector<HTMLElement>('.hero');
      const moonScene = document.querySelector<HTMLElement>('.moon-scene');
      const heroGrid = document.querySelector<HTMLElement>('.hero-grid');
      let motionFrame = 0;
      let pointerX = 0, pointerY = 0;
      let targetX = 0, targetY = 0;
      const renderMotion = () => {
        motionFrame = 0;
        if (motionPreference.matches || document.hidden) return;
        if (hero && moonScene && heroGrid) {
          const bounds = hero.getBoundingClientRect();
          const progress = Math.max(-1, Math.min(1, -bounds.top / Math.max(bounds.height, 1)));
          const x = finePointer.matches ? pointerX : 0;
          const y = finePointer.matches ? pointerY : 0;
          moonScene.style.setProperty('--scene-x', (x * 10).toFixed(1) + 'px');
          moonScene.style.setProperty('--scene-y', (y * 8 - progress * 26).toFixed(1) + 'px');
          heroGrid.style.setProperty('--grid-y', (progress * -18).toFixed(1) + 'px');
        }
      };
      const requestMotion = () => { if (!motionFrame && !motionPreference.matches) motionFrame = requestAnimationFrame(renderMotion); };
      if (!motionPreference.matches) {
        window.addEventListener('scroll', requestMotion, {passive:true});
        window.addEventListener('resize', requestMotion, {passive:true});
        if (finePointer.matches && hero) {
          hero.addEventListener('pointermove', event => {
            const rect = hero.getBoundingClientRect();
            targetX = ((event.clientX - rect.left) / rect.width - .5) * 2;
            targetY = ((event.clientY - rect.top) / rect.height - .5) * 2;
            pointerX += (targetX - pointerX) * .18;
            pointerY += (targetY - pointerY) * .18;
            requestMotion();
          }, {passive:true});
          hero.addEventListener('pointerleave', () => { targetX = 0; targetY = 0; pointerX = 0; pointerY = 0; requestMotion(); });
        }
        document.querySelectorAll<HTMLElement>('.signal-card').forEach(card => {
          card.addEventListener('pointermove', event => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty('--pointer-x', (event.clientX - rect.left) + 'px');
            card.style.setProperty('--pointer-y', (event.clientY - rect.top) + 'px');
          }, {passive:true});
        });
        document.addEventListener('visibilitychange', requestMotion);
      }
      document.querySelectorAll<HTMLElement>('.signal-card.reveal').forEach((card,index) => card.style.setProperty('--reveal-delay', (index * 90) + 'ms'));

      // Active section indicator.
      const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.section-dots a'));
      const sectionObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            sectionLinks.forEach(link => {
              const active = link.dataset.section === entry.target.id;
              link.classList.toggle('active', active);
              if (active) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });
          }
        });
      }, { rootMargin: '-38% 0px -38% 0px', threshold: 0 });
      sectionLinks.forEach(link => {
        const target = document.getElementById(link.dataset.section || '');
        if (target) sectionObserver.observe(target);
      });

      // Local-only early access list. No network request is made.
      const waitlist = document.querySelector<HTMLFormElement>('#waitlist')!;
      const waitlistInput = document.querySelector<HTMLInputElement>('#waitlistEmail')!;
      const waitlistMessage = document.querySelector<HTMLElement>('#waitlistMessage')!;
      waitlist.addEventListener('submit', event => {
        event.preventDefault();
        if (!waitlistInput.reportValidity()) return;
        const email = waitlistInput.value.trim().toLowerCase();
        if (email.length > 254) return;
        try {
          const stored = JSON.parse(localStorage.getItem('godhand-waitlist') || '[]');
          const emails: string[] = Array.isArray(stored) ? stored.filter((item): item is string => typeof item === 'string' && item.length <= 254).slice(0, 100) : [];
          if (!emails.includes(email)) {
            if (emails.length >= 100) {
              waitlistMessage.textContent = lang === 'fa' ? 'ظرفیت ذخیره‌سازی این دستگاه پر شده است.' : 'This device has reached its local storage limit.';
              return;
            }
            emails.push(email);
            localStorage.setItem('godhand-waitlist', JSON.stringify(emails));
          }
          waitlistMessage.textContent = lang === 'fa' ? 'به فهرست انتظار این دستگاه پیوستی ✦' : 'You joined this device’s waitlist ✦';
          waitlistMessage.classList.add('success');
          waitlistInput.value = '';
        } catch {
          waitlistMessage.textContent = lang === 'fa' ? 'ذخیره‌سازی مرورگر در دسترس نیست.' : 'Browser storage is unavailable.';
          waitlistMessage.classList.remove('success');
        }
      });

      // Original synthesized ambient tone; starts only after an explicit click.
      const soundButton = document.querySelector<HTMLButtonElement>('#soundToggle')!;
      let audioContext: AudioContext | null = null;
      let soundNodes: OscillatorNode[] = [];
      let soundGain: GainNode | null = null;
      const stopAmbient = () => {
        if (soundGain && audioContext) {
          soundGain.gain.setTargetAtTime(0, audioContext.currentTime, .18);
          const nodes = soundNodes;
          window.setTimeout(() => nodes.forEach(node => { try { node.stop(); } catch { /* Already stopped. */ } }), 900);
        }
        soundNodes = [];
        soundButton.classList.remove('playing');
        soundButton.setAttribute('aria-pressed', 'false');
        soundButton.querySelector('.sound-state')!.textContent = lang === 'fa' ? 'صدا خاموش' : 'SOUND OFF';
      };
      soundButton.addEventListener('click', async () => {
        if (soundNodes.length) { stopAmbient(); return; }
        try {
          const AudioCtor = window.AudioContext || (window as typeof window & {webkitAudioContext?: typeof AudioContext}).webkitAudioContext;
          if (!AudioCtor) throw new Error('Audio unavailable');
          audioContext ??= new AudioCtor();
          await audioContext.resume();
          soundGain = audioContext.createGain();
          soundGain.gain.setValueAtTime(0, audioContext.currentTime);
          soundGain.gain.setTargetAtTime(.018, audioContext.currentTime, .8);
          soundGain.connect(audioContext.destination);
          [55, 82.41, 110.0].forEach((frequency, index) => {
            const oscillator = audioContext!.createOscillator();
            const voiceGain = audioContext!.createGain();
            oscillator.type = index === 1 ? 'triangle' : 'sine';
            oscillator.frequency.value = frequency;
            voiceGain.gain.value = index === 0 ? .42 : .16;
            oscillator.connect(voiceGain);
            voiceGain.connect(soundGain!);
            oscillator.start();
            soundNodes.push(oscillator);
          });
          soundButton.classList.add('playing');
          soundButton.setAttribute('aria-pressed', 'true');
          soundButton.querySelector<HTMLElement>('.sound-state')!.textContent = lang === 'fa' ? 'صدا روشن' : 'SOUND ON';
        } catch {
          stopAmbient();
          soundButton.querySelector<HTMLElement>('.sound-state')!.textContent = lang === 'fa' ? 'صدا پشتیبانی نشد' : 'AUDIO UNAVAILABLE';
        }
      });
      document.addEventListener('visibilitychange', () => { if (document.hidden && soundNodes.length) stopAmbient(); });

      const observer = new IntersectionObserver(entries => entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
      }), {threshold:.12});
      document.querySelectorAll('.section, .signal-card, .quote-section, .gateway-frame, .intro-layout, .signals-heading').forEach(el => {
        el.classList.add('reveal'); observer.observe(el);
      });
    </script>
  </body>
</html>
