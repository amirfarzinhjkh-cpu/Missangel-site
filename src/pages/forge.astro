---
const title = "The Forge — GODHAND";
---
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#08090a" />
  <meta name="description" content="کارگاه ساختن؛ ایده‌ها را به عمل تبدیل کن. بخشی از جهان GODHAND." />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/godhand.css" />
  <link rel="stylesheet" href="/styles/ashen-atmosphere.css" />
  <link rel="stylesheet" href="/styles/forge.css" />
</head>
<body class="forge-page workspace-page">
  <header class="forge-header">
    <a class="forge-brand" href="/">GODHAND <span>/ THE FORGE</span></a>
    <nav aria-label="ناوبری"><a href="/">خانه</a><a href="/archive">آرشیو</a><a href="/idea-lab">کارگاه ایده‌ها</a></nav>
    <span class="forge-index">CHAPTER II · 2026</span>
  </header>
  <main class="forge-main">
    <section class="forge-hero">
      <p class="forge-kicker"><i></i> A PLACE FOR WHAT DOESN'T EXIST YET</p>
      <h1>ایده کافی نیست.<br/><em>بسازش.</em></h1>
      <p class="forge-lead">یک جرقه انتخاب کن. محدودیت‌ها را بپذیر. چیزی خلق کن که قبل از تو وجود نداشته.</p>
      <div class="forge-rule"><span>01 / THINK</span><span></span><span>02 / BUILD</span><span></span><span>03 / LEAVE A TRACE</span></div>
    </section>
    <section class="forge-workbench" aria-labelledby="challenge-title">
      <div class="forge-panel-head"><span>THE DAILY FORGE</span><span id="forge-date">—</span></div>
      <div class="forge-challenge">
        <span class="forge-label">TODAY'S CHALLENGE</span>
        <h2 id="challenge-title">یک چیز کوچک را بهتر کن.</h2>
        <p id="challenge-copy">از اطرافت چیزی انتخاب کن که همیشه نادیده‌اش می‌گیری؛ راهی برای بهتر کردنش پیدا کن.</p>
        <div class="forge-tags"><span id="challenge-type">OBSERVATION</span><span id="challenge-time">20 MIN</span></div>
        <button id="forge-roll" type="button">جرقه‌ی تازه <b>↻</b></button>
      </div>
      <div class="forge-notes">
        <label for="forge-note">ردپای امروزت</label>
        <textarea id="forge-note" maxlength="1200" rows="4" placeholder="ایده‌ات را اینجا ثبت کن؛ لازم نیست کامل باشد..."></textarea>
        <div class="forge-note-actions"><span id="forge-count">۰ / ۱۲۰۰</span><button id="forge-save" type="button">ثبت در دفترچه <b>↗</b></button></div>
        <p id="forge-status" role="status" aria-live="polite">یادداشت‌ها فقط روی همین دستگاه ذخیره می‌شوند.</p>
      </div>
    </section>
    <section class="forge-log">
      <div class="forge-log-head"><div><span class="forge-label">YOUR FOOTPRINTS</span><h2>چیزهایی که <em>ساختی.</em></h2></div><span id="forge-total">۰ ثبت</span></div>
      <div id="forge-list" class="forge-list"><p class="forge-empty">هنوز ردی ثبت نشده. اولین جرقه منتظر توست.</p></div>
    </section>
    <footer class="forge-footer"><a href="/">← بازگشت به جهان GODHAND</a><span>KEEP MOVING. KEEP MAKING.</span></footer>
  </main>
  <script src="/scripts/ashen-atmosphere.js" defer></script>
  <script src="/scripts/forge.js" defer></script>
</body>
</html>
