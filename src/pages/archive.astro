---
const title = "GODHAND — Endless Archive";
---
<!doctype html>
<html lang="fa" dir="rtl"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#080709"/><meta name="description" content="هر چیزی که ارزش نگه‌داشتن دارد ثبت کن؛ پیدا کن، مرتب کن و همراه خودت نگه دار."/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/><style>
:root{color-scheme:dark;--bg:#080709;--line:#ffffff1b;--muted:#a99b9d;--red:#a83242}*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}body{margin:0;min-height:100vh;color:#eee4e1;background:radial-gradient(ellipse at 80% 0%,#4b101b45,transparent 38%),linear-gradient(160deg,#080709,#100b10 55%,#080709);font-family:"Vazirmatn",sans-serif}body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.2;background-image:radial-gradient(#d7b9b2 .6px,transparent .8px);background-size:37px 43px}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}.wrap{position:relative;width:min(1120px,92%);margin:auto}.top{display:flex;justify-content:space-between;align-items:center;padding:25px 0;border-bottom:1px solid var(--line)}.brand{font:700 15px "DM Sans";letter-spacing:4px;color:#e6d4d0}.brand small{display:block;font-size:8px;letter-spacing:2px;color:#927b80;margin-top:5px}.actions,.toolbar,.form-actions{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.ghost,.primary,.danger{border:1px solid var(--line);background:#ffffff08;color:#e9d9d5;padding:10px 14px;cursor:pointer;transition:.2s}.ghost:hover,.primary:hover{border-color:#b64b59;background:#8e25331c}.primary{background:linear-gradient(110deg,#641622,#9c2b3b);border-color:#b64b5960}.danger{color:#e7a0a4}.hero{padding:65px 0 30px}.eyebrow,.meta{font:10px "DM Sans";letter-spacing:2.5px;color:#bb8589}.hero h1{font-size:clamp(42px,8vw,76px);line-height:1.2;font-weight:400;margin:18px 0}.hero h1 em{font-style:normal;color:#c44b58}.hero p{color:#b9aaab;max-width:680px;line-height:2}.layout{display:grid;grid-template-columns:minmax(260px,.75fr) minmax(0,1.25fr);gap:24px;padding:20px 0 70px}.panel,.entry{border:1px solid var(--line);background:linear-gradient(145deg,#1a1319ed,#0c0a0e);box-shadow:inset 0 1px #ffffff0c,0 20px 55px #0005}.panel{padding:22px;height:max-content;position:sticky;top:15px}.panel h2,.entries-head h2{font-size:18px;font-weight:500;margin:0 0 16px}.field{display:grid;gap:7px;margin:13px 0}.field label{font-size:12px;color:#c7b5b2}.field input,.field textarea,.field select,.search,.filter{width:100%;border:1px solid var(--line);background:#08070a;color:#f0e4e0;padding:11px;outline:none}.field textarea{min-height:115px;resize:vertical;line-height:1.8}.field input:focus,.field textarea:focus,.field select:focus,.search:focus,.filter:focus{border-color:#a94553;box-shadow:0 0 0 3px #a8324218}.field input[type=range]{padding:0;accent-color:#b43b48}.entries-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:13px}.entries-head h2{margin:0}.search{max-width:260px}.toolbar{margin-bottom:13px}.toolbar>*{flex:1;min-width:110px}.items{display:grid;gap:12px}.entry{padding:18px;transition:transform .2s,border-color .2s}.entry:hover{transform:translateY(-2px);border-color:#a9455366}.entry-top,.entry-foot{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.entry-top{color:#bd8589;font:10px "DM Sans";letter-spacing:1px}.entry h3{font-size:17px;font-weight:500;margin:12px 0 6px}.entry p{white-space:pre-wrap;color:#b8aaab;line-height:1.9;font-size:13px;margin:0}.entry-foot{margin-top:14px;color:#8f7c80;font-size:11px}.entry-actions{display:flex;gap:8px;flex-wrap:wrap}.entry-actions button{border:0;background:none;color:#c6a5a4;cursor:pointer;padding:5px}.empty{padding:38px 18px;text-align:center;border:1px dashed #ffffff24;color:#a99599;line-height:2}.notice{min-height:22px;color:#d49a9d;font-size:11px;margin-top:10px}.stats{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0;color:#a99599;font-size:11px}.stats span{border:1px solid var(--line);padding:7px 10px}.progressbar{height:4px;background:#ffffff16;margin-top:10px}.progressbar i{display:block;height:100%;background:#b43b48}.footer{padding:20px 0 34px;border-top:1px solid var(--line);color:#796b70;font:9px "DM Sans";letter-spacing:1.5px;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.file-input{display:none}@media(max-width:760px){.layout{grid-template-columns:1fr}.panel{position:static}.hero{padding-top:45px}.top{padding:18px 0}.entries-head{align-items:stretch;flex-direction:column}.search{max-width:none}.hero h1{font-size:46px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style><link rel="stylesheet" href="/styles/godhand.css"/></head><body class="workspace-page"><div class="wrap"><header class="top"><a class="brand" href="/">GODHAND<small>BEYOND THE ORDINARY</small></a><div class="actions"><button class="ghost" id="language" type="button">EN</button><a class="ghost" href="/">↖ <span data-fa="بازگشت" data-en="HOME">بازگشت</span></a></div></header>
<main><section class="hero"><div class="eyebrow">02 / PRESERVE WHAT MATTERS</div><h1 id="headline">آرشیو <em>بی‌انتها</em></h1><p id="intro">هر چیزی که ارزش نگه‌داشتن دارد ثبت کن؛ پیدا کن، مرتب کن و همراه خودت نگه دار.</p><div class="meta">LOCAL WORKSPACE / PRIVATE BY DESIGN</div><div class="stats"><span id="totalStat">۰ مورد</span><span id="extraStat">ذخیره‌سازی محلی</span></div></section>
<section class="layout"><form class="panel" id="editor"><h2 id="formTitle">ثبت یک یادداشت</h2><div class="field"><label for="title" data-fa="عنوان" data-en="Title">عنوان</label><input id="title" maxlength="90" required placeholder="عنوان را بنویس..."/></div><div class="field"><label for="body" data-fa="متن یادداشت" data-en="Note">متن یادداشت</label><textarea id="body" maxlength="5000" required placeholder="هرچه لازم است ثبت کن..."></textarea></div><div class="field"><label for="category" data-fa="دسته‌بندی" data-en="Category">دسته‌بندی</label><select id="category"><option value="thought">اندیشه</option><option value="discovery">کشف</option><option value="note">یادداشت</option><option value="personal">شخصی</option></select></div><div class="form-actions"><button class="primary" id="save" type="submit">ذخیره در آرشیو</button><button class="ghost" id="cancel" type="button" hidden>لغو</button></div><div class="notice" id="notice" role="status"></div></form>
<div><div class="entries-head"><h2 id="listTitle">ردپاهای ثبت‌شده <span id="count">0</span></h2><input class="search" id="search" type="search" placeholder="جست‌وجو..." aria-label="Search"/></div><div class="toolbar"><select class="filter" id="filter"><option value="all">همه موارد</option><option value="thought">اندیشه</option><option value="discovery">کشف</option><option value="note">یادداشت</option><option value="personal">شخصی</option></select><select class="filter" id="sort"><option value="new">جدیدترین</option><option value="old">قدیمی‌ترین</option><option value="az">عنوان A–Z</option></select><button class="ghost" id="export" type="button" data-fa="خروجی JSON" data-en="Export JSON">خروجی JSON</button><button class="ghost" id="import" type="button" data-fa="ورود اطلاعات" data-en="Import">ورود اطلاعات</button><input class="file-input" id="file" type="file" accept="application/json,.json"/></div><div class="items" id="items"><div class="empty">هنوز موردی ثبت نشده است.</div></div></div></section></main><footer class="footer"><span>© 2026 GODHAND</span><span>DATA STAYS IN THIS BROWSER</span><span>ARCHIVE / PRIVATE</span></footer></div>
<script>
// @ts-nocheck — DOM elements and imported JSON are runtime-validated in this client-side workspace.
const TYPE="archive", KEY="godhand-archive-v1", IS_IDEA=false, $=id=>document.getElementById(id);
let lang="fa",records=[],editing=null;
const dict={fa:{title:IS_IDEA?"کارگاه ایده‌ها":"آرشیو بی‌انتها",intro:IS_IDEA?"ایده را ثبت کن، پرورش بده و وقتی آماده شد به پروژه تبدیلش کن.":"هر چیزی که ارزش نگه‌داشتن دارد ثبت کن؛ پیدا کن، مرتب کن و همراه خودت نگه دار.",create:IS_IDEA?"ثبت یک ایده":"ثبت یک یادداشت",save:IS_IDEA?"ثبت ایده":"ذخیره در آرشیو",list:IS_IDEA?"ایده‌ها و پروژه‌ها":"ردپاهای ثبت‌شده",empty:"هنوز چیزی اینجا نیست. اولین مورد را ثبت کن.",edit:"ویرایش",del:"حذف",cancel:"لغو",update:"ثبت تغییرات",search:"جست‌وجو...",all:"همه موارد",new:"جدیدترین",old:"قدیمی‌ترین",az:"عنوان الف تا ی",export:"خروجی JSON",import:"ورود اطلاعات",local:"ذخیره‌شده روی این دستگاه",project:"پروژه",convert:"تبدیل به پروژه",idea:"بازگشت به ایده",priority:["کم","معمولی","بالا"],stage:["جرقه","در حال توسعه","برنامه‌ریزی‌شده","ساخته‌شده"],category:["اندیشه","کشف","یادداشت","شخصی"],saved:"ذخیره شد.",storage:"فضای ذخیره‌سازی در دسترس نیست.",confirm:"این مورد حذف شود؟",imported:"اطلاعات وارد شد.",bad:"فایل معتبر نیست.",due:"مهلت",progress:"پیشرفت",priorityLabel:"اولویت",items:"مورد",projects:"پروژه"},en:{title:IS_IDEA?"Idea Laboratory":"Endless Archive",intro:IS_IDEA?"Capture an idea, develop it, and turn it into a project when it is ready.":"Keep what matters. Find it, organize it and carry it with you.",create:IS_IDEA?"New idea":"New note",save:IS_IDEA?"Save idea":"Save to archive",list:IS_IDEA?"Ideas & projects":"Saved traces",empty:"Nothing here yet. Create the first entry.",edit:"Edit",del:"Delete",cancel:"Cancel",update:"Save changes",search:"Search...",all:"All entries",new:"Newest",old:"Oldest",az:"Title A–Z",export:"Export JSON",import:"Import",local:"Stored on this device",project:"Project",convert:"Turn into project",idea:"Back to idea",priority:["Low","Normal","High"],stage:["Seed","Developing","Planned","Built"],category:["Thought","Discovery","Note","Personal"],saved:"Saved.",storage:"Storage is unavailable.",confirm:"Delete this entry?",imported:"Data imported.",bad:"Invalid file.",due:"Target date",progress:"Progress",priorityLabel:"Priority",items:"entries",projects:"projects"}};
const t=()=>dict[lang],labels=()=>{[...$("category").options].forEach((o,i)=>o.textContent=(IS_IDEA?t().stage:t().category)[i]||o.textContent);if(IS_IDEA){[...$("priority").options].forEach((o,i)=>o.textContent=t().priority[i]);}};
function load(){try{const x=JSON.parse(localStorage.getItem(KEY)||"[]");records=Array.isArray(x)?x.filter(r=>r&&typeof r.id==="string"&&typeof r.title==="string"&&typeof r.body==="string").map(r=>({...r,created:r.created||new Date().toISOString(),updated:r.updated||r.created||new Date().toISOString(),progress:Number.isFinite(r.progress)?r.progress:(r.category==="built"?100:0),priority:r.priority||"normal",isProject:!!r.isProject})):[]}catch{records=[];notice(t().storage)}}
function persist(){try{localStorage.setItem(KEY,JSON.stringify(records));notice(t().saved);return true}catch{notice(t().storage);return false}}
function notice(s){$("notice").textContent=s}
function reset(){editing=null;$("editor").reset();if(IS_IDEA){$("progress").value=0;$("progressValue").textContent="0%";$("priority").value="normal"}$("formTitle").textContent=t().create;$("save").textContent=t().save;$("cancel").hidden=true}
function edit(r){editing=r.id;$("title").value=r.title;$("body").value=r.body;$("category").value=r.category;if(IS_IDEA){$("priority").value=r.priority||"normal";$("progress").value=r.progress||0;$("progressValue").textContent=(r.progress||0)+"%";$("due").value=r.due||""}$("formTitle").textContent=t().edit;$("save").textContent=t().update;$("cancel").hidden=false;window.scrollTo({top:0,behavior:"smooth"})}
function render(){const term=$("search").value.trim().toLocaleLowerCase(),filter=$("filter").value,sort=$("sort").value;let list=records.filter(r=>(r.title+" "+r.body).toLocaleLowerCase().includes(term));if(filter==="project")list=list.filter(r=>r.isProject);else if(filter!=="all")list=list.filter(r=>IS_IDEA?r.category===filter:r.category===filter);list.sort((a,b)=>sort==="old"?new Date(a.created)-new Date(b.created):sort==="az"?a.title.localeCompare(b.title):new Date(b.updated)-new Date(a.updated));$("count").textContent=list.length;$("totalStat").textContent=records.length+" "+t().items;$("extraStat").textContent=IS_IDEA?records.filter(r=>r.isProject).length+" "+t().projects:t().local;const host=$("items");host.replaceChildren();if(!list.length){const e=document.createElement("div");e.className="empty";e.textContent=t().empty;host.append(e);return}
for(const r of list){const card=document.createElement("article");card.className="entry";const top=document.createElement("div");top.className="entry-top";const tag=document.createElement("span");tag.textContent=IS_IDEA?(r.isProject?t().project:t().stage[["seed","developing","planned","built"].indexOf(r.category)]||r.category):t().category[["thought","discovery","note","personal"].indexOf(r.category)]||r.category;const date=document.createElement("time");date.textContent=new Date(r.updated).toLocaleDateString(lang==="fa"?"fa-IR":"en-GB");top.append(tag,date);const h=document.createElement("h3");h.textContent=r.title;const p=document.createElement("p");p.textContent=r.body;card.append(top,h,p);
if(IS_IDEA){const meta=document.createElement("div");meta.className="entry-foot";meta.textContent=t().priorityLabel+": "+t().priority[["low","normal","high"].indexOf(r.priority||"normal")]+" · "+t().progress+": "+(r.progress||0)+"%"+(r.due?" · "+t().due+": "+r.due:"");card.append(meta);const bar=document.createElement("div");bar.className="progressbar";const fill=document.createElement("i");fill.style.width=(r.progress||0)+"%";bar.append(fill);card.append(bar)}
const foot=document.createElement("div");foot.className="entry-foot";const stamp=document.createElement("span");stamp.textContent=t().local;const acts=document.createElement("div");acts.className="entry-actions";if(IS_IDEA){const convert=document.createElement("button");convert.type="button";convert.textContent=r.isProject?t().idea:t().convert;convert.addEventListener("click",()=>{r.isProject=!r.isProject;if(r.isProject){r.category="planned";r.progress=Math.max(r.progress||0,5)}r.updated=new Date().toISOString();persist();render()});acts.append(convert)}const ebtn=document.createElement("button");ebtn.type="button";ebtn.textContent=t().edit;ebtn.addEventListener("click",()=>edit(r));const dbtn=document.createElement("button");dbtn.type="button";dbtn.className="danger";dbtn.textContent=t().del;dbtn.addEventListener("click",()=>{if(!confirm(t().confirm))return;records=records.filter(x=>x.id!==r.id);if(editing===r.id)reset();persist();render()});acts.append(ebtn,dbtn);foot.append(stamp,acts);card.append(foot);host.append(card)}}
$("editor").addEventListener("submit",e=>{e.preventDefault();const title=$("title").value.trim(),body=$("body").value.trim();if(!title||!body)return;const now=new Date().toISOString(),extra=IS_IDEA?{priority:$("priority").value,progress:Number($("progress").value),due:$("due").value}:{};if(editing){const r=records.find(x=>x.id===editing);if(r)Object.assign(r,{title,body,category:$("category").value,updated:now,...extra})}else records.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now())+Math.random(),title,body,category:$("category").value,created:now,updated:now,isProject:false,...extra});if(persist()){reset();render()}});
$("cancel").addEventListener("click",reset);$("search").addEventListener("input",render);$("filter").addEventListener("change",render);$("sort").addEventListener("change",render);if(IS_IDEA)$("progress").addEventListener("input",()=> $("progressValue").textContent=$("progress").value+"%");
$("export").addEventListener("click",()=>{const blob=new Blob([JSON.stringify({app:"GODHAND",type:TYPE,version:2,exportedAt:new Date().toISOString(),records},null,2)],{type:"application/json"}),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download="godhand-"+TYPE+"-backup.json";a.click();URL.revokeObjectURL(url)});
$("import").addEventListener("click",()=>$("file").click());$("file").addEventListener("change",async e=>{const f=e.target.files?.[0];if(!f)return;try{const data=JSON.parse(await f.text()),incoming=Array.isArray(data)?data:data.records;if(!Array.isArray(incoming))throw Error();const valid=incoming.filter(r=>r&&typeof r.title==="string"&&typeof r.body==="string").map(r=>({...r,id:typeof r.id==="string"?r.id:(crypto.randomUUID?.()||String(Date.now())+Math.random()),created:r.created||new Date().toISOString(),updated:new Date().toISOString()}));const ids=new Set(records.map(r=>r.id));for(const r of valid){if(ids.has(r.id))r.id=(crypto.randomUUID?.()||String(Date.now())+Math.random());records.push(r)}if(persist()){notice(t().imported);render()}}catch{notice(t().bad)}e.target.value=""});
function language(next){lang=next;document.documentElement.lang=next;document.documentElement.dir=next==="fa"?"rtl":"ltr";$("language").textContent=next==="fa"?"EN":"FA";$("headline").innerHTML=IS_IDEA?(next==="fa"?"کارگاه <em>ایده‌ها</em>":"THE <em>IDEA LAB</em>"):(next==="fa"?"آرشیو <em>بی‌انتها</em>":"THE <em>ARCHIVE</em>");$("intro").textContent=t().intro;$("formTitle").textContent=editing?t().edit:t().create;$("editor").querySelector('label[for="body"]').textContent=next==="fa"?(IS_IDEA?"شرح ایده":"متن یادداشت"):(IS_IDEA?"Idea description":"Note");$("editor").querySelector('label[for="category"]').textContent=next==="fa"?(IS_IDEA?"مرحله":"دسته‌بندی"):(IS_IDEA?"Stage":"Category");$("save").textContent=editing?t().update:t().save;$("listTitle").childNodes[0].textContent=t().list+" ";$("search").placeholder=t().search;$("filter").options[0].textContent=t().all;[...$("sort").options].forEach((o,i)=>o.textContent=[t().new,t().old,t().az][i]);$("export").textContent=t().export;$("import").textContent=t().import;$("cancel").textContent=t().cancel;$("editor").querySelector('label[for="title"]').textContent=next==="fa"?"عنوان":"Title";if(IS_IDEA){$("editor").querySelector('label[for="priority"]').textContent=t().priorityLabel;$("editor").querySelector('label[for="progress"]').textContent=t().progress;$("editor").querySelector('label[for="due"]').textContent=t().due}$("extraStat").textContent=IS_IDEA?records.filter(r=>r.isProject).length+" "+t().projects:t().local;labels();render()}
$("language").addEventListener("click",()=>language(lang==="fa"?"en":"fa"));load();language("fa");
</script></body></html>