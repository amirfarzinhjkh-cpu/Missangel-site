---
const isArchive = true;
const title = isArchive ? "GODHAND — Archive" : "GODHAND — Idea Lab";
---
<!doctype html>
<html lang="fa" dir="rtl"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#080709"/><meta name="description" content="GODHAND — Archive of thoughts"/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/><style>
:root{color-scheme:dark;--bg:#080709;--panel:#121014;--line:#ffffff18;--muted:#a99b9d;--red:#a83242;--rose:#d2b8b4}*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}body{margin:0;min-height:100vh;color:#eee4e1;background:radial-gradient(ellipse at 80% 0%,#4b101b45,transparent 38%),linear-gradient(160deg,#080709,#100b10 55%,#080709);font-family:"Vazirmatn",sans-serif}body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.2;background-image:radial-gradient(#d7b9b2 0.6px,transparent .8px);background-size:37px 43px}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}.wrap{position:relative;width:min(1080px,92%);margin:auto}.top{display:flex;justify-content:space-between;align-items:center;padding:28px 0;border-bottom:1px solid var(--line)}.brand{font:700 15px "DM Sans";letter-spacing:4px;color:#e6d4d0}.brand small{display:block;font-size:8px;letter-spacing:2px;color:#927b80;margin-top:5px}.actions{display:flex;gap:12px;align-items:center}.ghost,.primary,.danger{border:1px solid var(--line);background:#ffffff08;color:#e9d9d5;padding:10px 15px;cursor:pointer;transition:.25s}.ghost:hover,.primary:hover{border-color:#b64b59;background:#8e25331c}.primary{background:linear-gradient(110deg,#641622,#9c2b3b);border-color:#b64b5960}.danger{color:#e7a0a4}.hero{padding:70px 0 34px}.eyebrow,.meta{font:10px "DM Sans";letter-spacing:2.5px;color:#bb8589}.hero h1{font-size:clamp(42px,8vw,82px);line-height:1.15;font-weight:400;margin:18px 0}.hero h1 em{font-style:normal;color:#c44b58}.hero p{color:#b9aaab;max-width:600px;line-height:2}.layout{display:grid;grid-template-columns:minmax(270px,.8fr) minmax(0,1.2fr);gap:26px;padding:22px 0 80px}.panel,.entry{border:1px solid var(--line);background:linear-gradient(145deg,#1a1319ed,#0c0a0e);box-shadow:inset 0 1px #ffffff0c,0 20px 55px #0005}.panel{padding:24px;height:max-content;position:sticky;top:18px}.panel h2,.entries-head h2{font-size:18px;font-weight:500;margin:0 0 18px}.field{display:grid;gap:8px;margin:14px 0}.field label{font-size:12px;color:#c7b5b2}.field input,.field textarea,.field select,.search{width:100%;border:1px solid var(--line);background:#08070a;color:#f0e4e0;padding:12px;outline:none}.field textarea{min-height:125px;resize:vertical;line-height:1.8}.field input:focus,.field textarea:focus,.field select:focus,.search:focus{border-color:#a94553;box-shadow:0 0 0 3px #a8324218}.form-actions{display:flex;gap:9px;flex-wrap:wrap}.entries-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}.entries-head h2{margin:0}.search{max-width:260px}.items{display:grid;gap:12px}.entry{padding:18px 20px;transition:transform .25s,border-color .25s}.entry:hover{transform:translateY(-3px);border-color:#a9455366}.entry-top{display:flex;justify-content:space-between;gap:10px;color:#bd8589;font:10px "DM Sans";letter-spacing:1px}.entry h3{font-size:17px;font-weight:500;margin:13px 0 6px}.entry p{white-space:pre-wrap;color:#b8aaab;line-height:1.9;font-size:13px;margin:0}.entry-foot{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:16px;color:#8f7c80;font-size:11px}.entry-actions{display:flex;gap:8px}.entry-actions button{border:0;background:none;color:#c6a5a4;cursor:pointer}.empty{padding:40px 18px;text-align:center;border:1px dashed #ffffff24;color:#a99599;line-height:2}.notice{min-height:22px;color:#d49a9d;font-size:11px;margin-top:10px}.footer{padding:20px 0 34px;border-top:1px solid var(--line);color:#796b70;font:9px "DM Sans";letter-spacing:1.5px;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}@media(max-width:760px){.layout{grid-template-columns:1fr}.panel{position:static}.hero{padding-top:48px}.top{padding:20px 0}.entries-head{align-items:stretch;flex-direction:column}.search{max-width:none}.hero h1{font-size:48px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style></head><body><div class="wrap"><header class="top"><a class="brand" href="/">GODHAND<small>BEYOND THE ORDINARY</small></a><div class="actions"><button class="ghost" id="language" type="button">EN</button><a class="ghost" href="/">↖ <span data-fa="بازگشت" data-en="HOME">بازگشت</span></a></div></header>
<main><section class="hero"><div class="eyebrow">02 / PRESERVE WHAT MATTERS</div><h1 id="headline">آرشیو <em>بی‌انتها</em></h1><p id="intro">فکرها، یادداشت‌ها و کشف‌هایت را اینجا نگه دار؛ مرتب، قابل جست‌وجو و همیشه در دسترس همین دستگاه.</p><div class="meta">LOCAL WORKSPACE / PRIVATE BY DESIGN</div></section>
<section class="layout"><form class="panel" id="editor"><h2 id="formTitle">ثبت یک یادداشت</h2><div class="field"><label for="title" data-fa="عنوان" data-en="Title">عنوان</label><input id="title" maxlength="90" required placeholder="مثلاً: چیزی که امروز فهمیدم"/></div><div class="field"><label for="body" data-fa="متن یادداشت" data-en="Note">متن یادداشت</label><textarea id="body" maxlength="5000" required placeholder="بنویس؛ لازم نیست کامل باشد..."></textarea></div><div class="field"><label for="category" data-fa="دسته‌بندی" data-en="Category">دسته‌بندی</label><select id="category"><option value="thought">اندیشه</option><option value="discovery">کشف</option><option value="note">یادداشت</option><option value="personal">شخصی</option></select></div><div class="form-actions"><button class="primary" id="save" type="submit">ذخیره در آرشیو</button><button class="ghost" id="cancel" type="button" hidden>لغو</button></div><div class="notice" id="notice" role="status"></div></form>
<div><div class="entries-head"><h2 id="listTitle">ردپاهای ثبت‌شده <span id="count">0</span></h2><input class="search" id="search" type="search" placeholder="جست‌وجو..." aria-label="Search"/></div><div class="items" id="items"><div class="empty" id="empty">هنوز چیزی ثبت نکرده‌ای. اولین ردپا را بگذار.</div></div></div></section></main><footer class="footer"><span>© 2026 GODHAND</span><span>DATA STAYS IN THIS BROWSER</span><span>ARCHIVE / 001</span></footer></div>
<script>
const TYPE="archive", KEY="godhand-"+TYPE+"-v1", root=document.documentElement;
let lang="fa", records=[], editing=null;
const $=id=>document.getElementById(id);
const copy={fa:{archive:["آرشیو بی‌انتها","فکرها، یادداشت‌ها و کشف‌هایت را اینجا نگه دار؛ مرتب، قابل جست‌وجو و همیشه در دسترس همین دستگاه.","ثبت یک یادداشت","متن یادداشت","دسته‌بندی","ذخیره در آرشیو","ردپاهای ثبت‌شده","هنوز چیزی ثبت نکرده‌ای. اولین ردپا را بگذار.","اندیشه","کشف","یادداشت","شخصی","حذف","ویرایش","ذخیره شد.","جست‌وجو..."],idea:["کارگاه ایده‌ها","ایده‌های خام را ثبت کن، به آن‌ها شکل بده و مسیر تبدیل‌شدنشان به پروژه را دنبال کن.","ثبت یک ایده","شرح ایده","مرحله","ثبت ایده","ایده‌های تو","هنوز ایده‌ای اینجا نیست. اولین جرقه را ثبت کن.","جرقه","در حال توسعه","برنامه‌ریزی‌شده","ساخته‌شده","حذف","ویرایش","ثبت شد.","جست‌وجو..."]},en:{archive:["Endless Archive","Keep thoughts, notes and discoveries organized, searchable and available on this device.","New entry","Note","Category","Save to archive","Saved traces","Nothing here yet. Leave the first trace.","Thought","Discovery","Note","Personal","Delete","Edit","Saved.","Search..."],idea:["Idea Laboratory","Capture raw ideas, shape them and follow their evolution into projects.","New idea","Idea description","Stage","Save idea","Your ideas","No ideas yet. Capture the first spark.","Seed","Developing","Planned","Built","Delete","Edit","Saved.","Search..."]}};
const tr=()=>copy[lang][TYPE], safeLoad=()=>{try{const x=JSON.parse(localStorage.getItem(KEY)||"[]");records=Array.isArray(x)?x.filter(v=>v&&typeof v.id==="string"&&typeof v.title==="string"&&typeof v.body==="string"):[]}catch{records=[];$("notice").textContent=lang==="fa"?"ذخیره‌سازی مرورگر در دسترس نیست.":"Browser storage unavailable."}};
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(records));$("notice").textContent=tr()[14]}catch{$("notice").textContent=lang==="fa"?"فضای ذخیره‌سازی در دسترس نیست.":"Storage unavailable."}};
const labels=()=>{const s=$("category");[...s.options].forEach((o,i)=>o.textContent=tr()[8+i]);};
const render=()=>{const term=$("search").value.trim().toLowerCase(), host=$("items");host.replaceChildren();const filtered=records.filter(r=>(r.title+" "+r.body).toLowerCase().includes(term));$("count").textContent=records.length;if(!filtered.length){const e=document.createElement("div");e.className="empty";e.textContent=term?(lang==="fa"?"چیزی پیدا نشد.":"No matches found."):tr()[7];host.append(e);return}
filtered.slice().reverse().forEach(r=>{const card=document.createElement("article");card.className="entry";const top=document.createElement("div");top.className="entry-top";const tag=document.createElement("span");tag.textContent=tr()[8+Math.max(0,["thought","discovery","note","personal"].indexOf(r.category))]||r.category;const date=document.createElement("time");date.textContent=new Date(r.updated||r.created).toLocaleDateString(lang==="fa"?"fa-IR":"en-GB");top.append(tag,date);const h=document.createElement("h3");h.textContent=r.title;const p=document.createElement("p");p.textContent=r.body;const foot=document.createElement("div");foot.className="entry-foot";const stamp=document.createElement("span");stamp.textContent=lang==="fa"?"ثبت‌شده در دستگاه":"Saved on this device";const acts=document.createElement("div");acts.className="entry-actions";const edit=document.createElement("button");edit.type="button";edit.textContent=tr()[13];edit.addEventListener("click",()=>loadEdit(r));const del=document.createElement("button");del.type="button";del.className="danger";del.textContent=tr()[12];del.addEventListener("click",()=>{if(!confirm(lang==="fa"?"این مورد حذف شود؟":"Delete this entry?"))return;records=records.filter(x=>x.id!==r.id);if(editing===r.id)reset();save();render()});acts.append(edit,del);foot.append(stamp,acts);card.append(top,h,p,foot);host.append(card)})};
const reset=()=>{editing=null;$("editor").reset();$("formTitle").textContent=tr()[2];$("save").textContent=tr()[5];$("cancel").hidden=true};
const loadEdit=r=>{editing=r.id;$("title").value=r.title;$("body").value=r.body;$("category").value=r.category;$("formTitle").textContent=lang==="fa"?"ویرایش":"Edit";$("save").textContent=lang==="fa"?"ثبت تغییرات":"Update";$("cancel").hidden=false;window.scrollTo({top:0,behavior:"smooth"})};
$("editor").addEventListener("submit",e=>{e.preventDefault();const title=$("title").value.trim(),body=$("body").value.trim();if(!title||!body)return;const now=new Date().toISOString();if(editing){const r=records.find(x=>x.id===editing);if(r)Object.assign(r,{title,body,category:$("category").value,updated:now})}else records.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now())+Math.random(),title,body,category:$("category").value,created:now,updated:now});save();reset();render()});
$("cancel").addEventListener("click",reset);$("search").addEventListener("input",render);
function applyLanguage(next){lang=next;root.lang=next;root.dir=next==="fa"?"rtl":"ltr";$("language").textContent=next==="fa"?"EN":"FA";$("headline").innerHTML=TYPE==="archive"?(next==="fa"?'آرشیو <em>بی‌انتها</em>':'THE <em>ARCHIVE</em>'):(next==="fa"?'کارگاه <em>ایده‌ها</em>':'THE <em>IDEA LAB</em>');$("intro").textContent=tr()[1];$("formTitle").textContent=tr()[2];$("editor").querySelector('label[for="body"]').textContent=tr()[3];$("editor").querySelector('label[for="category"]').textContent=tr()[4];$("save").textContent=editing?(next==="fa"?"ثبت تغییرات":"Update"):tr()[5];$("listTitle").childNodes[0].textContent=tr()[6]+" ";$("search").placeholder=tr()[15];$("empty")?.replaceChildren(document.createTextNode(tr()[7]));labels();render()}
$("language").addEventListener("click",()=>applyLanguage(lang==="fa"?"en":"fa"));safeLoad();applyLanguage("fa");
</script></body></html>